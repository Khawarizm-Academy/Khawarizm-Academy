# Production profile — loaded when DJANGO_ENV=production on self-hosted boxes.
# On Vercel, configuration comes from Project Environment Variables instead.
# Never commit real secrets: host environment variables override this file.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=djs-de101f6151e77c09e891f904b62837061123fe1641583d4f90fb9d4191946e33
# Comma-separated hostnames the API answers on.
DJANGO_ALLOWED_HOSTS=khawarizmacademy.vercel.app
# Comma-separated frontend origins allowed to call the API.
DJANGO_CORS_ALLOWED_ORIGINS=https://khawarizmacademy.vercel.app

# ---------------------------------------------------------------------------
# Firebase — the same web config as `.env.development`.
#
#   Firebase console -> Project settings -> Your apps -> SDK setup and
#   configuration -> Config.
#
# Only Auth is used, so these three ARE the whole config — ignore the
# Storage/Messaging/Analytics keys the console also shows.
#
# Prefer setting these in the host's Environment Variables (on Vercel:
# Settings -> Environment Variables) so production keys are not committed.
# The web config is public and safe either way; the service account is not.
#
# `dev:` fallback tokens are OFF the moment FIREBASE_PROJECT_ID is set, and
# `FIREBASE_ALLOW_DEV_TOKENS` defaults to DEBUG (false here).
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=                 # <project>.firebaseapp.com
FIREBASE_PROJECT_ID=                  # <project>  (this is the on/off switch)

# The Admin SDK service account is a SECRET. On Vercel, point
# `FIREBASE_CREDENTIALS_PATH` at a file bundled by the deploy, or paste the
# JSON into `FIREBASE_CREDENTIALS` — never into this file.
# FIREBASE_CREDENTIALS_PATH=
# FIREBASE_CREDENTIALS=
