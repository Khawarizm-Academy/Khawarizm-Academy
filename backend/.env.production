# Production profile — loaded when DJANGO_ENV=production.
# Keep real secrets in the host environment: it overrides this file.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-real-secret
DJANGO_ALLOWED_HOSTS=api.example.com
# Comma-separated frontend origins allowed to call the API.
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
