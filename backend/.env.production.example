# Copy to .env.production (git-ignored) and fill in real values.
#
# Loaded only when DJANGO_ENV=production on a NON-Vercel host. Vercel ignores
# dotenv files — set these same keys under Project → Settings → Environment
# Variables instead.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Postgres in production; leave unset in development to keep SQLite.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Firebase — the production project's web config (Auth only).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# Refuse the dev:<email> fallback in production.
FIREBASE_ALLOW_DEV_TOKENS=false
