# Development profile — loaded when DJANGO_ENV is unset or `development`
# (see config/settings.py). Real values on a dev box belong in `.env.local`
# (git-ignored via `.env.*`), never committed.
#
# Committed intentionally: it carries the non-secret dev defaults, and the
# commented placeholders below document every key a feature can read — the
# same names used in `.env.production` (git-ignored, create it on the box)
# and on Vercel's Project Environment Variables.

DJANGO_ENV=development
DJANGO_DEBUG=true
# Placeholder on purpose (also in settings defaults). A non-debug run refuses
# to boot while the secret is still this value.
DJANGO_SECRET_KEY=dev-only-insecure-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origins allowed to call the API. Leave commented: settings.py
# already defaults to the Vite dev origins (localhost:5173).
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database — unset here, so development runs on the local SQLite file.
# Comment out to point development code at Postgres/Aiven.
# DATABASE_URL=postgresql://user:password@host:5432/name?sslmode=require
# SQLITE_PATH=/data/db.sqlite3
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Firebase — only Auth. Leave empty to let `dev:<email>[:<role>]` tokens work
# locally. Setting FIREBASE_PROJECT_ID switches dev tokens off in the API.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# Secret Admin SDK service account (path or raw JSON) — setting it here would
# count as committing a secret; use .env.local or the host environment.
# FIREBASE_CREDENTIALS_PATH=
# FIREBASE_CREDENTIALS=
# FIREBASE_ALLOW_DEV_TOKENS=true
# FIREBASE_CLOCK_SKEW_SECONDS=60
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Telegram video host (features/videohosting) — all four are secrets; ingest
# needs the API pair + bot, serving only needs the stream bot + channel id.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_STREAM_TOKEN=
# TELEGRAM_CHANNEL_ID=
# STREAM_TOKEN_TTL_HOURS=6
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Google Drive managed host (features/videohosting/providers/google_drive.py).
# OAuth client keys + upload folder id are secrets; the human refresh token is
# stored server-side in DriveGrant after the consent callback.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# GOOGLE_DRIVE_OAUTH_REDIRECT_URI=
# VIDEO_HOSTING_DEFAULT_PROVIDER=google_drive
# VIDEO_HOSTING_USE_FFMPEG=true
# ---------------------------------------------------------------------------
