# Development profile — loaded when DJANGO_ENV=development (the default).
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,khawarizm-academy.firebaseapp.com
# Comma-separated frontend origins allowed to call the API.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175,https://khawarizm-academy.firebaseapp.com

# ---------------------------------------------------------------------------
# Firebase — the development project's web config.
#
# Only Auth is used, so these three ARE the whole config. The console also
# shows storageBucket / messagingSenderId / appId / measurementId; Auth does
# not need them, so they are deliberately not read.
#
# The web config is PUBLIC: it ships inside the browser bundle, which is why it
# can live here. Production keys belong in the host environment, not in git
# (`.env.production` is ignored).
#
# Setting FIREBASE_PROJECT_ID switches the server to real verification and turns
# the `dev:<email>` fallback off, so the seeded demo logins stop working here.
# Clear it to get them back.
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=AIzaSyAU4wASrifWsFYXOLFjd8OgT9Z0MMFRuv0
FIREBASE_AUTH_DOMAIN=khawarizm-academy.firebaseapp.com
FIREBASE_PROJECT_ID=khawarizm-academy

# The Admin SDK service account is a SECRET — never commit it. Set one of these
# only when a privileged Admin SDK call is needed:
#   FIREBASE_CREDENTIALS_PATH=/absolute/path/serviceAccount.json
#   FIREBASE_CREDENTIALS={"type":"service_account", ...}
# Verifying ID tokens needs just FIREBASE_PROJECT_ID, so dev runs fine without it.
# FIREBASE_CREDENTIALS_PATH=
# FIREBASE_CREDENTIALS=

# Set false to refuse `dev:<email>` tokens even in development.
# FIREBASE_ALLOW_DEV_TOKENS=true

# How many seconds the verifier tolerates between this machine's clock and
# Google's (0-60; the SDK caps it). A lagging clock rejects every sign-in with
# "Token used too early", which WSL does after a suspend. Sync the clock for a
# real fix; this is the safety margin.
# FIREBASE_CLOCK_SKEW_SECONDS=60

# ---------------------------------------------------------------------------
# Telegram video hosting (features/videohosting).
#
# A Telegram channel is the video CDN; the backend only handles tokens,
# manifests, and keys. The API credentials + ingest bot are needed for
# `manage.py ingest_video`; the throwaway stream bot's token is the only one
# that appears in redirect URLs (it can read ciphertext only). Keys are SECRETS
# — never commit them; set them in the host environment for production.
# ---------------------------------------------------------------------------
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_STREAM_TOKEN=
# TELEGRAM_CHANNEL_ID=
# Playback grant lifetime in hours (default 6).
# STREAM_TOKEN_TTL_HOURS=6
