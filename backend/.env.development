# Development profile — loaded when DJANGO_ENV=development (the default).
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated frontend origins allowed to call the API.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# ---------------------------------------------------------------------------
# Firebase — the development project's web config.
#
# Only Auth is used, so these three ARE the whole config. The console also
# shows storageBucket / messagingSenderId / appId / measurementId; Auth does
# not need them, so they are deliberately not read.
#
# The web config is PUBLIC: it ships inside the browser bundle, which is why it
# can live here. Production keys belong in the host environment, not in git
# (`.env.production` is ignored).
#
# Setting FIREBASE_PROJECT_ID switches the server to real verification and turns
# the `dev:<email>` fallback off, so the seeded demo logins stop working here.
# Clear it to get them back.
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=AIzaSyAU4wASrifWsFYXOLFjd8OgT9Z0MMFRuv0
FIREBASE_AUTH_DOMAIN=khawarizm-academy.firebaseapp.com
FIREBASE_PROJECT_ID=khawarizm-academy

# The Admin SDK service account is a SECRET — never commit it. Set one of these
# only when a privileged Admin SDK call is needed:
#   FIREBASE_CREDENTIALS_PATH=/absolute/path/serviceAccount.json
#   FIREBASE_CREDENTIALS={"type":"service_account", ...}
# Verifying ID tokens needs just FIREBASE_PROJECT_ID, so dev runs fine without it.
# FIREBASE_CREDENTIALS_PATH=
# FIREBASE_CREDENTIALS=

# Set false to refuse `dev:<email>` tokens even in development.
# FIREBASE_ALLOW_DEV_TOKENS=true
