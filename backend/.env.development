# Development profile — loaded when DJANGO_ENV=development (the default).
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated frontend origins allowed to call the API.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# ---------------------------------------------------------------------------
# Firebase — paste your project's web config below to switch real sign-in on.
#
#   Firebase console -> Project settings -> Your apps -> SDK setup and
#   configuration -> Config, then copy these three values across.
#
# Only Auth is used, so these three ARE the whole config — ignore the
# Storage/Messaging/Analytics keys the console also shows.
#
# The web config is PUBLIC: it ships inside the browser bundle, so it is safe
# to commit. Leave FIREBASE_PROJECT_ID empty to keep the `dev:<email>` login
# (every request still works locally, with no Firebase project at all).
#
# All three must land together: the API refuses to boot on a half-filled config,
# because it would only fail later in the browser.
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=                 # <project>.firebaseapp.com
FIREBASE_PROJECT_ID=                  # <project>  (this is the on/off switch)

# The Admin SDK service account is a SECRET — never commit it. Set one of these
# only when a privileged Admin SDK call is needed:
#   FIREBASE_CREDENTIALS_PATH=/absolute/path/serviceAccount.json
#   FIREBASE_CREDENTIALS={"type":"service_account", ...}
# Verifying ID tokens needs just FIREBASE_PROJECT_ID, so dev runs fine without it.
# FIREBASE_CREDENTIALS_PATH=
# FIREBASE_CREDENTIALS=

# Set false to refuse `dev:<email>` tokens even in development.
# FIREBASE_ALLOW_DEV_TOKENS=true
