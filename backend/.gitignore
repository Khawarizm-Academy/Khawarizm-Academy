# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtualenv
.venv/
venv/
env/

# Local database (created by migrate; never commit it)
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Static collected by collectstatic
/staticfiles/

# Local env
# The committed profile carries non-secret dev defaults + commented
# placeholders (mirrors the root .gitignore's re-include); .env.production
# and real values stay untracked through this ignore.
.env*
!.env.development
