    { "tone": "muted", "indent": 0, "text": "// خوارزمية البحث الثنائي المحسنة - بايثون 3.12" },
    { "tone": "keyword", "indent": 0, "text": "def binary_search(arr, target):" },
    { "tone": "plain", "indent": 1, "text": "left, right = 0, len(arr) - 1" },
    { "tone": "gold", "indent": 1, "text": "while left <= right:" },
    { "tone": "plain", "indent": 2, "text": "mid = (left + right) // 2" },
    { "tone": "ok", "indent": 2, "text": "if arr[mid] == target: return mid" },
    { "tone": "plain", "indent": 2, "text": "elif arr[mid] < target: left = mid + 1" },
    { "tone": "plain", "indent": 2, "text": "else: right = mid - 1" },
    { "tone": "bad", "indent": 1, "text": "return -1" }
  ],
