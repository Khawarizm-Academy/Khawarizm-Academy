# Development profile — loaded automatically by `npm run dev`.
VITE_API_BASE_URL=http://localhost:8000/api

# No Firebase keys here on purpose. The SPA fetches them from the API at boot
# (`GET /api/auth/config`), so the backend env is the single place to edit:
#   backend/.env.development  ->  the FIREBASE_* block.
# That keeps one project per environment and avoids a rebuild when it changes.
